{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataGoblin",
  "version": "0.1.5",
  "identifier": "dev.datagoblin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "DataGoblin",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A focused SQL workspace for PostgreSQL and SQL Server.",
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzN0NFNjE0MTI4MkY0QUUKUldTdTlJSVNGT1o4ZyswOUpkVWFuR0wzaGlWT25GZnI0S01OWmU1SnhFNUt6WTVZVDdVdEY0MHUK",
      "endpoints": [
        "https://github.com/GoblinAssembly/DataGoblin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
